{
  "session": "W3-토",
  "title": "내 주제의 지저분한 엑셀을, 내 스킬로",
  "capture": "내 파일의 진단표 · 정답과 대조한 화면",
  "tiers": {
    "최소": {
      "label": "내 데이터를 내 규칙으로 정리했다",
      "checks": [
        {
          "type": "glob_min",
          "pattern": "cleaner/rules/*.json",
          "min": 3,
          "label": "cleaner/rules/ 에 내 데이터의 규칙 파일이 없다"
        }
      ]
    },
    "기본": {
      "label": "내 데이터 · 진단 · 정답과 대조 · 올리기",
      "checks": [
        {
          "type": "glob_min",
          "pattern": "cleaner/tools/answer/*",
          "min": 3,
          "label": "cleaner/tools/answer/ 에 내 데이터의 정답이 없다"
        },
        {
          "type": "glob_min",
          "pattern": "cleaner/진단/*_진단.md",
          "min": 3,
          "label": "cleaner/진단/ 에 내 데이터의 진단 파일이 없다"
        },
        {
          "type": "git_commits_since",
          "repo": "cleaner",
          "min": 1,
          "label": "토요일 뒤로 cleaner 에 남긴 저장 지점이 없다 — 올렸는가"
        }
      ]
    },
    "도전": {
      "label": "정리기에 처방 둘을 더했다",
      "checks": [
        {
          "type": "file_changed",
          "path": "cleaner/clean.js",
          "mock": "w3-cleaner/clean.js",
          "label": "clean.js 가 목업 그대로다"
        }
      ]
    }
  }
}
